! Regenerate both variants after re-recording:
!   asciinema convert --output-format asciicast-v2 demo.cast demo-v2.cast
!   svg-term --in demo-v2.cast --out demo-<variant>.svg --window \
!            --width 78 --height 44 --term xresources --profile <variant>.xresources
!
! Note: svg-term only honours --profile when the path is outside the repo.
! Generate into a temp directory and copy the SVG back.
